# Kopiera den här filen till ".env" och fyll i värdena själv.
# ".env" är ignorerad av git. Lägg ALDRIG hemligheter i den här filen.

PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Admin-login
# Välj ett eget lösenord (inte ditt riktiga). Används för att logga in som admin.
ADMIN_PASSWORD=
# Minst 32 tecken. Skapa en själv: kör "openssl rand -base64 32" i terminalen.
SESSION_SECRET=

# Supabase (Project Settings → API Keys). Använd den HEMLIGA nyckeln, bara här.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
