# Kopiera den här filen till ".env" och fyll i värdena själv.
# ".env" är ignorerad av git. Lägg ALDRIG hemligheter i den här filen.

PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Minst 32 tecken. Skapa en själv: kör "openssl rand -base64 32" i terminalen.
# Används för att signera inloggningscookien.
SESSION_SECRET=

# Supabase (Project Settings → API Keys)
SUPABASE_URL=
# HEMLIG nyckel: bara i backend, aldrig i frontend och aldrig i git.
SUPABASE_SECRET_KEY=
# Publishable nyckel: används för att registrera och logga in användare (Supabase Auth).
SUPABASE_PUBLISHABLE_KEY=
